# ============================================================================
# 👑 PROJECT NEXUS — OS GENESIS EDITION (ENV MATRIX V20.95)
# Súbor: .env / .env.local (Pre lokálny beh aj Vercel Dashboard)
# Uzol: SYS02_AGENCY_OPERATOR // Doména: agency.projekt-nexus.sk
# Status: 100% OPERATIONAL // ZERO-STANDBY // V20 CHIRURGICKÝ ŠTANDARD
# ============================================================================

# ----------------------------------------------------------------------------
# 1. 🆔 SYSTÉMOVÁ IDENTITA A KONTROLA VERZIÍ
# ----------------------------------------------------------------------------
# Unikátny identifikátor uzla Nexus Agency v rámci monorepa OS Genesis
VITE_NODE_ID="SYS02_AGENCY_OPERATOR"

# Globálna verzia jadra pre synchronizáciu s V20 architektúrou
VITE_CORE_VERSION="AGENCY-STANDALONE V20.95"

# ----------------------------------------------------------------------------
# 2. 🌐 SMEROVANIE DOMÉN A KANONICKÝ ROUTING
# ----------------------------------------------------------------------------
# Ostrá produkčná adresa autonómnej aplikácie Nexus Agency
VITE_APP_URL="https://agency.projekt-nexus.sk"

# Centrálny portál a materský monolit OS Genesis (prepojenie z dropdownu)
VITE_MAIN_PORTAL_URL="https://projekt-nexus.sk"

# ----------------------------------------------------------------------------
# 3. 🗄️ SUPABASE CORE BACKEND (MASTER DATABÁZA OS GENESIS)
# ----------------------------------------------------------------------------
# Projektová URL adresa pre pripojenie Supabase klienta
VITE_SUPABASE_URL="https://ljyvsolsgliephsfkfgx.supabase.co"

# Verejný anonymný API kľúč pre databázové dotazy (anon key)
VITE_SUPABASE_ANON_KEY="sb_anon_placeholder_nexus_v20"

# ----------------------------------------------------------------------------
# 4. 💳 KOMERCIA, OUTREACH A OFICIÁLNA KOMUNIKÁCIA
# ----------------------------------------------------------------------------
# Odkaz na provízny Ko-Fi obchod pre objednávku 18 B2B služieb
VITE_KOFI_URL="https://ko-fi.com/cybertech_architect/commissions"

# Primárny kontakt pre odosielanie dopytov a diagnostiku klientov
VITE_OFFICIAL_CONTACT_EMAIL="agency@projekt-nexus.sk"

# ----------------------------------------------------------------------------
# 5. 🔊 AUDIO / SOUND FX ENGINE (KYBERNETICKÁ ODOZVA ROZHRANIA)
# ----------------------------------------------------------------------------
# Globálny prepínač zvukových efektov (true = zapnuté, false = tichý režim)
VITE_SOUND_ENABLED="true"

# Predvolená hlasitosť pre SoundFX (rozsah 0.0 až 1.0)
VITE_SOUND_DEFAULT_VOLUME="0.4"

# ----------------------------------------------------------------------------
# 6. 🚨 SYSTEM LOG & GITHUB COMMITS (AUTO-FETCH & RELEASE RADAR)
# ----------------------------------------------------------------------------
# Nový aktuálny repozitár po premenovaní pre sťahovanie commitov
VITE_GITHUB_REPO="dusanfajnorbusiness-ui/nexus-agency-monorepo_7.2"

# Osobný GitHub Token (PAT) pre neobmedzené volania (ak ho máš, vlož sem za rovná sa)
# Ak ho nemáš, nechaj prázdne úvodzovky "" - repozitár je verejný a commity stiahne aj tak!
VITE_GITHUB_TOKEN=""